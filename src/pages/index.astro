---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <canvas
    class="home-particle-field"
    data-home-particle-field
    aria-hidden="true"></canvas>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="home-page-layer app-layout"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        远在天边，<span class="text-accent">好东西在眼前。</span>
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p class="max-w-2xl text-lg leading-8">
        这里是我的 AI 实践笔记，也是一个持续生长的创作空间。
        我会记录真实的尝试、踩过的坑、值得反复使用的方法，以及偶尔出现的灵感。
      </p>
      <p class="text-muted-foreground mt-3">
        从一个具体问题出发，把复杂的东西想清楚、做出来，再诚实地写下来。
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={getRelativeLocaleUrl(locale, "about")}
        >
          了解更多
        </LinkButton>
      </p>
      <div class="mt-8 grid gap-3 sm:grid-cols-3">
        <div class="cosmic-card border-border rounded-lg border p-4">
          <strong class="block">AI 实践</strong>
          <span class="text-muted-foreground mt-1 block text-sm"
            >模型、工作流与真实项目</span
          >
        </div>
        <div class="cosmic-card border-border rounded-lg border p-4">
          <strong class="block">方法沉淀</strong>
          <span class="text-muted-foreground mt-1 block text-sm"
            >可复用的经验与思考</span
          >
        </div>
        <div class="cosmic-card border-border rounded-lg border p-4">
          <strong class="block">创作展示</strong>
          <span class="text-muted-foreground mt-1 block text-sm"
            >作品、实验与新鲜想法</span
          >
        </div>
      </div>
      <a
        href="/words/"
        class="cosmic-card border-border mt-4 flex flex-wrap items-center justify-between gap-3 rounded-lg border p-4"
      >
        <span>
          <strong class="block">背单词 · yuansays words</strong>
          <span class="text-muted-foreground mt-1 block text-sm"
            >从四级词汇开始，用跟写、听写和间隔复习每天练一点。</span
          >
        </span>
        <span class="text-accent inline-flex items-center gap-1 font-medium">
          开始练习 <IconArrowRight class="size-5" />
        </span>
      </a>
      <a
        href="/listen/"
        class="cosmic-card border-border mt-3 flex flex-wrap items-center justify-between gap-3 rounded-lg border p-4"
      >
        <span>
          <strong class="block">逐句听说 · yuansays listen</strong>
          <span class="text-muted-foreground mt-1 block text-sm"
            >导入自己的音视频和字幕，逐句重听、录音跟读，再与原声对照。</span
          >
        </span>
        <span class="text-accent inline-flex items-center gap-1 font-medium">
          开始练习 <IconArrowRight class="size-5" />
        </span>
      </a>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.featured}
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer class="home-page-layer" />
</Layout>

<style>
  .home-particle-field {
    position: fixed;
    z-index: 0;
    top: 0;
    left: 0;
    inset: 0;
    width: 100vw;
    height: 100svh;
    pointer-events: none;
    background:
      radial-gradient(
        circle at 14% 18%,
        color-mix(in srgb, var(--accent) 8%, transparent),
        transparent 32%
      ),
      radial-gradient(
        circle at 86% 72%,
        color-mix(in srgb, var(--accent) 6%, transparent),
        transparent 34%
      );
    opacity: 0.92;
  }

  .home-page-layer,
  :global(body:has(.home-particle-field) > header) {
    position: relative;
    z-index: 1;
  }

  :global(body:has(.home-particle-field)) {
    position: relative;
    isolation: isolate;
    overflow-x: hidden;
  }

  :global(body:has(.home-particle-field) > header > div) {
    background: color-mix(in srgb, var(--background) 82%, transparent);
    -webkit-backdrop-filter: blur(0.75rem);
    backdrop-filter: blur(0.75rem);
  }

  .cosmic-card {
    background: color-mix(in srgb, var(--background) 76%, transparent);
    -webkit-backdrop-filter: blur(0.65rem);
    backdrop-filter: blur(0.65rem);
    transition:
      transform 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .cosmic-card:hover {
    border-color: color-mix(in srgb, var(--accent) 58%, var(--border));
    box-shadow: 0 0.85rem 2.6rem
      color-mix(in srgb, var(--accent) 10%, transparent);
    transform: translateY(-0.2rem);
  }
</style>

<script>
  type RGB = { r: number; g: number; b: number };
  type Particle = {
    x: number;
    y: number;
    driftX: number;
    driftY: number;
    impulseX: number;
    impulseY: number;
    radius: number;
    phase: number;
  };
  type TrailPoint = { x: number; y: number; life: number };
  type Spark = TrailPoint & { vx: number; vy: number; radius: number };
  type Ripple = { x: number; y: number; radius: number; life: number };

  const runtimeWindow = window as Window & {
    __homeParticleCleanup?: () => void;
  };

  function parseColor(value: string, fallback: RGB): RGB {
    const color = value.trim();
    const shortHex = color.match(/^#([\da-f])([\da-f])([\da-f])$/i);
    const hex = color.match(/^#([\da-f]{2})([\da-f]{2})([\da-f]{2})$/i);
    const rgb = color.match(/rgba?\(\s*(\d+)\D+(\d+)\D+(\d+)/i);

    if (shortHex) {
      return {
        r: parseInt(shortHex[1] + shortHex[1], 16),
        g: parseInt(shortHex[2] + shortHex[2], 16),
        b: parseInt(shortHex[3] + shortHex[3], 16),
      };
    }

    if (hex) {
      return {
        r: parseInt(hex[1], 16),
        g: parseInt(hex[2], 16),
        b: parseInt(hex[3], 16),
      };
    }

    if (rgb) {
      return { r: Number(rgb[1]), g: Number(rgb[2]), b: Number(rgb[3]) };
    }

    return fallback;
  }

  function initParticleField() {
    runtimeWindow.__homeParticleCleanup?.();

    const canvas = document.querySelector<HTMLCanvasElement>(
      "[data-home-particle-field]"
    );
    const context = canvas?.getContext("2d");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const coarsePointer = window.matchMedia("(pointer: coarse)");

    if (!canvas || !context || reducedMotion.matches || coarsePointer.matches) {
      return;
    }

    let width = window.innerWidth;
    let height = window.innerHeight;
    let particles: Particle[] = [];
    let trail: TrailPoint[] = [];
    let sparks: Spark[] = [];
    let ripples: Ripple[] = [];
    let animationFrame = 0;
    let accent: RGB = { r: 0, g: 108, b: 172 };
    let foreground: RGB = { r: 40, g: 39, b: 40 };
    const pointer = {
      x: width / 2,
      y: height / 2,
      previousX: width / 2,
      previousY: height / 2,
      active: false,
    };

    const rgba = (color: RGB, alpha: number) =>
      `rgba(${color.r}, ${color.g}, ${color.b}, ${alpha})`;

    const updatePalette = () => {
      const styles = getComputedStyle(document.documentElement);
      accent = parseColor(styles.getPropertyValue("--accent"), accent);
      foreground = parseColor(
        styles.getPropertyValue("--foreground"),
        foreground
      );
    };

    const createParticle = (): Particle => {
      const angle = Math.random() * Math.PI * 2;
      const speed = 0.06 + Math.random() * 0.16;
      return {
        x: Math.random() * width,
        y: Math.random() * height,
        driftX: Math.cos(angle) * speed,
        driftY: Math.sin(angle) * speed,
        impulseX: 0,
        impulseY: 0,
        radius: 0.8 + Math.random() * 1.45,
        phase: Math.random() * Math.PI * 2,
      };
    };

    const resize = () => {
      width = window.innerWidth;
      height = window.innerHeight;
      const density = Math.floor((width * height) / 18000);
      const particleCount = Math.min(96, Math.max(44, density));
      const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = Math.floor(width * pixelRatio);
      canvas.height = Math.floor(height * pixelRatio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
      particles = Array.from({ length: particleCount }, createParticle);
    };

    const movePointer = (event: PointerEvent) => {
      if (event.pointerType === "touch") return;

      const movement = Math.hypot(
        event.clientX - pointer.previousX,
        event.clientY - pointer.previousY
      );
      pointer.x = event.clientX;
      pointer.y = event.clientY;
      pointer.active = true;
      trail.push({ x: pointer.x, y: pointer.y, life: 1 });

      if (movement > 3) {
        const sparkCount = movement > 22 ? 2 : 1;
        for (let index = 0; index < sparkCount; index += 1) {
          sparks.push({
            x: pointer.x + (Math.random() - 0.5) * 9,
            y: pointer.y + (Math.random() - 0.5) * 9,
            vx: (Math.random() - 0.5) * 0.9,
            vy: (Math.random() - 0.5) * 0.9,
            radius: 0.7 + Math.random() * 1.7,
            life: 1,
          });
        }
      }

      pointer.previousX = pointer.x;
      pointer.previousY = pointer.y;
      if (trail.length > 26) trail.splice(0, trail.length - 26);
      if (sparks.length > 72) sparks.splice(0, sparks.length - 72);
    };

    const releasePointer = (event: PointerEvent) => {
      if (event.relatedTarget === null) pointer.active = false;
    };

    const createRipple = (event: PointerEvent) => {
      if (event.pointerType === "touch") return;
      ripples.push({
        x: event.clientX,
        y: event.clientY,
        radius: 8,
        life: 1,
      });
      if (ripples.length > 5) ripples.shift();
    };

    const draw = () => {
      context.clearRect(0, 0, width, height);

      if (pointer.active) {
        const glow = context.createRadialGradient(
          pointer.x,
          pointer.y,
          0,
          pointer.x,
          pointer.y,
          165
        );
        glow.addColorStop(0, rgba(accent, 0.18));
        glow.addColorStop(0.3, rgba(accent, 0.08));
        glow.addColorStop(1, rgba(accent, 0));
        context.fillStyle = glow;
        context.beginPath();
        context.arc(pointer.x, pointer.y, 165, 0, Math.PI * 2);
        context.fill();
      }

      trail = trail.filter(point => point.life > 0.02);
      trail.forEach((point, index) => {
        point.life *= 0.93;
        if (index === 0) return;
        const previous = trail[index - 1];
        context.strokeStyle = rgba(accent, point.life * 0.28);
        context.lineWidth = 0.8 + point.life * 1.5;
        context.beginPath();
        context.moveTo(previous.x, previous.y);
        context.lineTo(point.x, point.y);
        context.stroke();
      });

      particles.forEach(particle => {
        if (pointer.active) {
          const dx = pointer.x - particle.x;
          const dy = pointer.y - particle.y;
          const distance = Math.max(Math.hypot(dx, dy), 0.1);

          if (distance < 230) {
            const attraction = (1 - distance / 230) * 0.018;
            particle.impulseX += (dx / distance) * attraction;
            particle.impulseY += (dy / distance) * attraction;

            if (distance < 58) {
              const repulsion = (1 - distance / 58) * 0.075;
              particle.impulseX -= (dx / distance) * repulsion;
              particle.impulseY -= (dy / distance) * repulsion;
            }
          }
        }

        particle.phase += 0.008;
        particle.impulseX *= 0.955;
        particle.impulseY *= 0.955;
        particle.x +=
          particle.driftX +
          particle.impulseX +
          Math.cos(particle.phase) * 0.018;
        particle.y +=
          particle.driftY +
          particle.impulseY +
          Math.sin(particle.phase) * 0.018;

        if (particle.x < -16) particle.x = width + 16;
        if (particle.x > width + 16) particle.x = -16;
        if (particle.y < -16) particle.y = height + 16;
        if (particle.y > height + 16) particle.y = -16;
      });

      const connectionDistance = 128;
      context.lineWidth = 0.55;
      for (let first = 0; first < particles.length; first += 1) {
        for (let second = first + 1; second < particles.length; second += 1) {
          const a = particles[first];
          const b = particles[second];
          const distance = Math.hypot(a.x - b.x, a.y - b.y);
          if (distance >= connectionDistance) continue;

          context.strokeStyle = rgba(
            foreground,
            (1 - distance / connectionDistance) * 0.075
          );
          context.beginPath();
          context.moveTo(a.x, a.y);
          context.lineTo(b.x, b.y);
          context.stroke();
        }
      }

      particles.forEach(particle => {
        const distanceToPointer = pointer.active
          ? Math.hypot(pointer.x - particle.x, pointer.y - particle.y)
          : Infinity;
        const nearPointer = Math.max(0, 1 - distanceToPointer / 220);

        if (nearPointer > 0) {
          context.strokeStyle = rgba(accent, nearPointer * 0.32);
          context.lineWidth = 0.75;
          context.beginPath();
          context.moveTo(pointer.x, pointer.y);
          context.lineTo(particle.x, particle.y);
          context.stroke();
        }

        context.fillStyle = rgba(
          nearPointer > 0.08 ? accent : foreground,
          0.2 + nearPointer * 0.68
        );
        context.beginPath();
        context.arc(
          particle.x,
          particle.y,
          particle.radius + nearPointer * 1.35,
          0,
          Math.PI * 2
        );
        context.fill();
      });

      sparks = sparks.filter(spark => spark.life > 0.02);
      sparks.forEach(spark => {
        spark.x += spark.vx;
        spark.y += spark.vy;
        spark.life *= 0.94;
        context.fillStyle = rgba(accent, spark.life * 0.82);
        context.beginPath();
        context.arc(
          spark.x,
          spark.y,
          spark.radius * spark.life,
          0,
          Math.PI * 2
        );
        context.fill();
      });

      ripples = ripples.filter(ripple => ripple.life > 0.02);
      ripples.forEach(ripple => {
        ripple.radius += 3.4;
        ripple.life *= 0.95;
        context.strokeStyle = rgba(accent, ripple.life * 0.5);
        context.lineWidth = 1.4 * ripple.life;
        context.beginPath();
        context.arc(ripple.x, ripple.y, ripple.radius, 0, Math.PI * 2);
        context.stroke();
      });

      animationFrame = requestAnimationFrame(draw);
    };

    const themeObserver = new MutationObserver(updatePalette);
    const cleanup = () => {
      cancelAnimationFrame(animationFrame);
      window.removeEventListener("resize", resize);
      window.removeEventListener("pointermove", movePointer);
      window.removeEventListener("pointerout", releasePointer);
      window.removeEventListener("pointerdown", createRipple);
      window.removeEventListener("blur", deactivatePointer);
      themeObserver.disconnect();
      runtimeWindow.__homeParticleCleanup = undefined;
    };
    const deactivatePointer = () => {
      pointer.active = false;
    };

    updatePalette();
    resize();
    window.addEventListener("resize", resize);
    window.addEventListener("pointermove", movePointer, { passive: true });
    window.addEventListener("pointerout", releasePointer, { passive: true });
    window.addEventListener("pointerdown", createRipple, { passive: true });
    window.addEventListener("blur", deactivatePointer);
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    document.addEventListener("astro:before-swap", cleanup, { once: true });
    runtimeWindow.__homeParticleCleanup = cleanup;
    animationFrame = requestAnimationFrame(draw);
  }

  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
    initParticleField();
  });
</script>
